# MapleMatch Environment Variables
# Copy this file to .env and fill in the values

# === Frontend (Next.js — prefix with NEXT_PUBLIC_) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_API_URL=http://localhost:8000
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# === Backend (FastAPI) ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maplematch
REDIS_URL=redis://localhost:6379/0
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true

# === CMHC Open Data ===
CMHC_API_URL=https://api-prd.cmhc-schl.gc.ca/cmba/api
CMHC_API_KEY=

# === Email / SMTP (optional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@maplematch.ca

# === Production Deploy ===
POSTGRES_USER=maplematch
POSTGRES_PASSWORD=
POSTGRES_DB=maplematch
